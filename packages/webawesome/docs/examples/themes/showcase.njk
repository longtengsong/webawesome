    <title>Web Awesome: 主题展示</title>

    <!-- Web Awesome -->
    <link rel="stylesheet" href="/dist/styles/webawesome.css" />
    <script type="module" src="/dist/webawesome.loader.js"></script>

    <!-- Available themes -->
    {% for theme in themer.themes %}
      <link rel="stylesheet" href="/dist/styles/themes/{{theme.filename}}" />
    {% endfor %}

    <!-- Available palettes -->
    {% for palette in themer.palettes %}
      <link rel="stylesheet" href="/dist/styles/color/palettes/{{palette.filename}}" />
    {% endfor %}

    <!-- Available fonts -->
    {% for font in themer.fonts %}
      {% if font.href %}
        <link rel="stylesheet" href="{{ font.href }}" />
      {% endif %}
    {% endfor %}

    <!-- Set the initial theme, palette, variants, and color scheme based on URL params -->
    <script type="module">
      const htmlElement = document.documentElement;
      const urlParams = new URLSearchParams(window.location.search);

      function setClass(prefix, value) {
        if (!value) return;
        htmlElement.classList.forEach(className => {
          if (className.startsWith(prefix)) htmlElement.classList.remove(className);
        });
        htmlElement.classList.add(`${prefix}${value}`);
      }

      // Color scheme
      const colorScheme = urlParams.get('color-scheme');
      if (colorScheme === 'dark') {
        htmlElement.classList.add('wa-dark');
      } else if (colorScheme === 'light') {
        htmlElement.classList.remove('wa-dark');
      }

      // Theme, palette, and variant color assignments
      setClass('wa-theme-', urlParams.get('theme'));
      setClass('wa-palette-', urlParams.get('palette'));
      ['brand', 'neutral', 'success', 'warning', 'danger'].forEach(variant => {
        setClass(`wa-${variant}-`, urlParams.get(`color-${variant}`));
      });
    </script>

    <script type="module">
      import { setDefaultIconFamily } from '/dist/webawesome.js';

      // Create a mutation observer to watch for changes to data-font-family attribute
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'attributes' && mutation.attributeName === 'data-font-family') {
            const fontFamily = document.documentElement.getAttribute('data-font-family');
            if (fontFamily) {
              setDefaultIconFamily(fontFamily);
            }
          }
        });
      });

      // Start observing the html element for attribute changes
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-font-family']
      });

      // Also check for initial value if it exists
      const initialFontFamily = document.documentElement.getAttribute('data-font-family');
      if (initialFontFamily) {
        setDefaultIconFamily(initialFontFamily);
      }
    </script>
  </head>
