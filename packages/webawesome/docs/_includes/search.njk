<wa-dialog id="site-search" without-header light-dismiss>
  <div id="site-search-container">
    {# Header #}
    <header>
      <div id="site-search-input-wrapper">
        <wa-input
          id="site-search-input"
          type="search"
          with-clear
          placeholder="搜索&hellip;"
          autofocus
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          enterkeyhint="go"
          spellcheck="false"
          maxlength="100"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="true"
          aria-controls="site-search-listbox"
          aria-haspopup="listbox"
          aria-activedescendant
        >
          <wa-icon slot="start" name="search"></wa-icon>
        </wa-input>
      </div>
    </header>

    {# Body #}
    <div id="site-search-body">
      <ul
        id="site-search-listbox"
        role="listbox"
        aria-label="搜索结果"
      ></ul>
      <div id="site-search-empty">
        <wa-icon name="web-awesome" family="brands"></wa-icon>
        无结果
      </div>
    </div>

    {# Footer #}
    <footer class="wa-gap-xl">
      <small>
        <kbd aria-label="上"><wa-icon name="arrow-up" family="micro"></wa-icon></kbd>
        <kbd aria-label="下"><wa-icon name="arrow-down" family="micro"></wa-icon></kbd>
        导航
      </small>

      <small>
        <kbd>Enter</kbd>
        选择
      </small>

      <small><kbd>Esc</kbd> 关闭</small>
    </footer>
  </div>
</wa-dialog>
