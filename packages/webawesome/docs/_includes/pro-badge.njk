{% macro proBadge(params) %}
  {% set description = params.description or "这需要 Web Awesome Pro 访问权限" %}
  {% set badgeId = params.id or ("pro-badge-" + ("" | uniqueId(8))) %}
  <wa-badge appearance="accent" pill class="pro" id="{{ badgeId }}" data-pro-badge>专业版</wa-badge>
  <wa-tooltip for="{{ badgeId }}">{{ description }}</wa-tooltip>
{% endmacro %}
