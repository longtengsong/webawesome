<h3>表单控件</h3>

```html {.example}
<form class="wa-stack">
  <wa-input label="输入" placeholder="占位符"></wa-input>
  <wa-select label="选择" value="option-1">
    <wa-option value="option-1">选项 1</wa-option>
    <wa-option value="option-2">选项 2</wa-option>
    <wa-option value="option-3">选项 3</wa-option>
  </wa-select>
  <wa-textarea label="文本域" placeholder="占位符"></wa-textarea>
  <wa-radio-group label="单选组" name="a" value="1">
    <wa-radio value="1">选项 1</wa-radio>
    <wa-radio value="2">选项 2</wa-radio>
    <wa-radio value="3">选项 3</wa-radio>
  </wa-radio-group>
  <wa-checkbox>复选框</wa-checkbox>
  <wa-switch>开关</wa-switch>
  <wa-slider label="范围"></wa-slider>
  <wa-button>按钮</wa-button>
</form>
```

<h3>进度</h3>

```html {.example}
<div class="wa-stack">
  <wa-progress-bar value="50" max="100"></wa-progress-bar>
  <wa-progress-ring value="50" max="100"></wa-progress-ring>
  <wa-spinner></wa-spinner>
</div>
```