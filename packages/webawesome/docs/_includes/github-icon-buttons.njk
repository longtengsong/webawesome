<wa-button id="github-repo-button" href="{{ site.github.repo }}" rel="noopener noreferrer" target="_blank" appearance="plain" pill>
  <wa-icon family="brands" name="github" label="在 GitHub 上查看项目"></wa-icon>
</wa-button>
<wa-tooltip for="github-repo-button" distance="2">在 GitHub 上查看项目</wa-tooltip>
<wa-button id="github-star-button" href="{{ site.github.stargazers }}" rel="noopener noreferrer" target="_blank" appearance="plain" pill>
  <wa-icon name="star" variant="regular" label="在 GitHub 上为项目点赞"></wa-icon>
</wa-button>
<wa-tooltip for="github-star-button" distance="2">在 GitHub 上为项目点赞</wa-tooltip>
