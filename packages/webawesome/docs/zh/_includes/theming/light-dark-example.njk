<div class="wa-grid">
  <wa-card class="wa-light">
    <div slot="header" class="wa-split wa-color-text-quiet">
      <h4 class="wa-heading-s">亮色</h4>
      <wa-icon name="sun-bright" variant="regular"></wa-icon>
    </div>
    <div class="wa-stack">
      <wa-input label="华夫饼数量" type="number" value="3"></wa-input>
      <wa-select label="配料" multiple value="jelly-beans">
        <wa-option value="whipped-cream">鲜奶油</wa-option>
        <wa-option value="hershey">好时巧克力</wa-option>
        <wa-option value="jelly-beans">果冻豆</wa-option>
      </wa-select>
      <wa-button appearance="filled" variant="brand">
        <wa-icon slot="start" name="waffle"></wa-icon>
        制作华夫饼
      </wa-button>
    </div>
  </wa-card>

  <wa-card class="wa-dark">
    <div slot="header" class="wa-split wa-color-text-quiet">
      <h4 class="wa-heading-s">暗色</h4>
      <wa-icon name="moon-stars" variant="regular"></wa-icon>
    </div>
    <div class="wa-stack">
      <wa-input label="华夫饼数量" type="number" value="3"></wa-input>
      <wa-select label="配料" multiple value="jelly-beans">
        <wa-option value="whipped-cream">鲜奶油</wa-option>
        <wa-option value="hershey">好时巧克力</wa-option>
        <wa-option value="jelly-beans">果冻豆</wa-option>
      </wa-select>
      <wa-button appearance="filled" variant="brand">
        <wa-icon slot="start" name="waffle"></wa-icon>
        制作华夫饼
      </wa-button>
    </div>
  </wa-card>
</div>